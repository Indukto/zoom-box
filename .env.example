# Release-signing environment variables (read directly via System.getenv in
# app/build.gradle.kts). Copy to a gitignored `.env`-style export or set them
# in your shell/CI before a signed `./gradlew assembleRelease`.
# Without these, release builds stay unsigned (used by F-Droid, which signs
# the APK itself). Values here are placeholders only.
KEYSTORE_PATH=./my-upload-key.jks
STORE_PASSWORD=placeholder-store-password
KEY_ALIAS=upload
KEY_PASSWORD=placeholder-key-password
