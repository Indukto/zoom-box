# Defaults used by the Secrets Gradle Plugin when .env is missing locally.
# Mirror the keys in your private .env (gitignored) to override at runtime.
# Values here are placeholders only -- they will produce an invalid release
# signing config; replace before shipping a release build.
KEYSTORE_PATH=./my-upload-key.jks
STORE_PASSWORD=placeholder-store-password
KEY_ALIAS=upload
KEY_PASSWORD=placeholder-key-password
