*.iml
.gradle
.kotlin
/local.properties
# IDE — keep only shared run configs + inspection profiles, ignore the rest.
/.idea/*
!/.idea/.gitignore
!/.idea/.name
!/.idea/runConfigurations/
!/.idea/inspectionProfiles/
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties
.env
debug.keystore
# Upload key for Play Store release builds — never commit.
/my-upload-key.jks
*.jks
# Firebase/Google Services config has no purpose in this project any more
# (Firebase stack removed), but ignored defensively in case it is ever
# re-introduced or copied in by mistake.
/google-services.json
/app/google-services.json

# Freebuff desktop app local SQLite state — never commit.
.freebuff/

# Local reference clone used for comparison; ignore the entire checkout.
/third_party/dazz-retro-camera/

# Build outputs — never commit.
/app/debug/
/app/release/*.apk
/app/release/mapping.txt
/app/release/output-metadata.json
/.build_tmp/
__pycache__/
*.pyc

# Agent scratch: implementation plans, task artifacts, walkthroughs and
# session plans — never commit.
/.artifacts/
/.zcode/

# Internal-only: Play Store docs and dev tools stay local, not public.
/docs/
/tools/
