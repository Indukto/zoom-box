<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <!--
        Deliberately NO media-library permission. The gallery reads only the
        photos this installation created: MediaStore rows we inserted ourselves
        (implicit app-uid ownership) plus the app-private working copies under
        getExternalFilesDir(Pictures). READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE
        would only add visibility into rows owned by other apps or by a previous
        install, and Google Play restricts those permissions to apps whose core
        purpose is broad photo access. Photos written by a previous install stay
        reachable through the system gallery and file manager.
    -->

    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <!-- Advertise RAW + Camera2 support to Google Play without blocking install
         on devices that lack these capabilities. -->
    <uses-feature android:name="android.hardware.camera2.raw" android:required="false" />
    <uses-feature android:name="android.hardware.camera2.full" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!--
            The UI is locked to portrait (screenOrientation="portrait") so the
            viewfinder and controls never rotate with the device. Saved photos
            are still oriented correctly for how the phone is held: under an
            orientation lock Display.getRotation() keeps reporting ROTATION_0,
            so the app tracks the PHYSICAL device orientation with an
            OrientationEventListener (sensor) instead. Every capture path
            reads that tracked rotation live — triggerImageCapture refreshes
            the CameraX target rotation at capture time, and the DNG
            (DngCreator EXIF) path receives it the same way. So holding the
            phone sideways saves a landscape photo while the UI stays upright.
            configChanges is kept so the activity is never recreated (the
            camera session stays bound; Compose recomposes naturally).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenLayout|smallestScreenSize|screenSize|keyboardHidden"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
