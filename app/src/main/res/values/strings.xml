    <!-- Privacy summary (see docs/play-store/PRIVACY_POLICY.md for the full
         store-listing version). -->
    <string name="privacy_h_about">About this app</string>
    <string name="privacy_p_about">ZoomBox Camera is an offline camera app. It declares no internet permission, so Android blocks all network access: the app cannot transmit data anywhere. There are no ads, no analytics, no trackers and no crash reporting.</string>
    <string name="privacy_h_photos">Photos &amp; camera</string>
    <string name="privacy_p_photos">Photos are captured, processed and stored only on your device (in Pictures/ZoomBoxCamera/ and the app\'s private storage). The app never writes your location or GPS coordinates into photos. A photo leaves your device only when you share it yourself.</string>
    <string name="privacy_h_permissions">Permissions</string>
    <string name="privacy_p_permissions">Camera: required to take photos, requested on first launch. Photos &amp; videos: lets the gallery show photos the app saved after a reinstall. There is no background access — every read or write is triggered by you in the app.</string>
    <string name="privacy_h_backup">Backups</string>
    <string name="privacy_p_backup">Your camera settings (film look, grid lines, etc.) may be included in Android\'s automatic device backup, which is stored in your Google account and visible only to you. Photos are excluded from backups. You can turn backups off in Android system settings.</string>
    <string name="privacy_h_nodata">No data reaches the developer</string>
    <string name="privacy_p_nodata">The developer receives no data from you: no account, no identifiers, no crash logs, no usage statistics. There is therefore no data the developer could access, correct, export or delete for you. To remove your data, delete photos in the gallery or uninstall the app, which removes all remaining app data.</string>
    <string name="privacy_h_children">Children</string>
    <string name="privacy_p_children">This app is not directed at children under 13 and does not collect personal data from any user of any age.</string>
    <string name="privacy_h_rights">Your rights &amp; contact</string>
    <string name="privacy_p_rights">Under the EU General Data Protection Regulation you have rights of access, rectification, erasure, restriction of processing, data portability and objection, plus the right to lodge a complaint with a supervisory authority (in Germany: the data protection authority of your federal state). Because the developer holds no personal data about you, there is nothing to exercise these rights against on the developer side.</string>

